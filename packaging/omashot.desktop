[Desktop Entry]
Type=Application
Name=OmaShot
GenericName=Screenshot Tool
Comment=Capture, annotate and style screenshots
Exec=omashot-ui
Icon=omashot
Terminal=false
Categories=Graphics;Utility;
Keywords=screenshot;capture;annotation;OCR;

#!/usr/bin/env bash
set -euo pipefail
plugin="$HOME/.config/omarchy/plugins/omashot"
if [[ ! -f $plugin/shell.qml ]]; then
  source_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
  plugin="$source_root/plugin"
fi
mode=${1:-open}
case $mode in
  open|history|preferences) ;;
  region|window|fullscreen|repeat|active|scroll|text|ocr|qr) ;;
  *) echo 'Usage: omashot-ui [open|history|preferences|region|window|fullscreen|repeat|active|scroll|text|ocr|qr]' >&2; exit 2 ;;
esac
if command -v omarchy-shell >/dev/null && [[ $(omarchy-shell shell summon omashot '{}' 2>/dev/null || true) == ok ]]; then
  ready=0
  for ((attempt=0; attempt<50; attempt++)); do
    status=$(omarchy-shell omashot status 2>/dev/null || true)
    if [[ $status == \{* ]]; then ready=1; break; fi
    sleep 0.1
  done
  if (( ! ready )); then echo 'OmaShot was summoned but its command handler did not become ready.' >&2; exit 1; fi
  case $mode in
    history|preferences) exec omarchy-shell omashot "$mode" ;;
    region|window|fullscreen|repeat|active|scroll|text|ocr|qr) exec omarchy-shell omashot capture "$mode" ;;
    *) exit 0 ;;
  esac
fi
# A standalone shell has its own IPC endpoint. Reuse it if already running.
if qs ipc -p "$plugin" call omashot open >/dev/null 2>&1; then
  case $mode in
    history|preferences) exec qs ipc -p "$plugin" call omashot "$mode" ;;
    region|window|fullscreen|repeat|active|scroll|text|ocr|qr) exec qs ipc -p "$plugin" call omashot capture "$mode" ;;
    *) exit 0 ;;
  esac
fi
# Initial standalone entry opens the launcher. Capture modes are dispatched once IPC is ready.
qs -p "$plugin" >/dev/null 2>&1 &
qs_pid=$!
for ((attempt=0; attempt<40; attempt++)); do
  if qs ipc -p "$plugin" call omashot open >/dev/null 2>&1; then
    case $mode in
      history|preferences) exec qs ipc -p "$plugin" call omashot "$mode" ;;
      region|window|fullscreen|repeat|active|scroll|text|ocr|qr) exec qs ipc -p "$plugin" call omashot capture "$mode" ;;
      *) exit 0 ;;
    esac
  fi
  kill -0 "$qs_pid" 2>/dev/null || { echo 'OmaShot Quickshell failed to start.' >&2; exit 1; }
  sleep 0.1
done
echo 'OmaShot Quickshell did not become ready within four seconds.' >&2
exit 1
